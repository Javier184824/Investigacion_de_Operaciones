  <object class="GtkWindow" id="main_window">
    <property name="title">Método Simplex – Entrada del modelo</property>
    <property name="default_width">900</property>
    <property name="default_height">720</property>
    <signal name="destroy" handler="on_main_window_destroy"/>
    <child>
      <object class="GtkScrolledWindow">
        <property name="visible">True</property>
        <child>
          <object class="GtkBox" id="box_main">
            <property name="visible">True</property>
            <property name="orientation">vertical</property>
            <property name="margin">10</property>
            <property name="spacing">10</property>
            <child>
              <object class="GtkFrame">
                <property name="visible">True</property>
                <property name="label_xalign">0.5</property>
                <child type="label">
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="label">&lt;b&gt;General Data&lt;/b&gt;</property>
                    <property name="use_markup">True</property>
                  </object>
                </child>
                <child>
                  <object class="GtkGrid" id="grid_general">
                    <property name="visible">True</property>
                    <property name="margin">8</property>
                    <property name="column_spacing">6</property>
                    <property name="row_spacing">6</property>
                    <child>
                      <object class="GtkLabel" id="lbl_nombre">
                        <property name="visible">True</property>
                        <property name="label">Problem Name:</property>
                        <property name="xalign">1</property>
                      </object>
                      <packing>
                        <property name="left_attach">0</property>
                        <property name="top_attach">0</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkEntry" id="entry_nombre">
                        <property name="visible">True</property>
                        <property name="hexpand">True</property>
                        <property name="placeholder_text">Ej: Knapsack Problem</property>
                      </object>
                      <packing>
                        <property name="left_attach">1</property>
                        <property name="top_attach">0</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkLabel" id="lbl_nvars">
                        <property name="visible">True</property>
                        <property name="label">Number of variables (2–15):</property>
                        <property name="xalign">1</property>
                      </object>
                      <packing>
                        <property name="left_attach">0</property>
                        <property name="top_attach">1</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkSpinButton" id="spin_vars">
                        <property name="visible">True</property>
                        <property name="width_chars">7</property>
                        <property name="adjustment">variables_limit</property>
                        <property name="digits">0</property>
                        <property name="numeric">True</property>
                        <property name="halign">start</property>
                        <signal name="value-changed" handler="on_spin_vars_changed"/>
                      </object>
                      <packing>
                        <property name="left_attach">1</property>
                        <property name="top_attach">1</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkLabel" id="lbl_nrestr">
                        <property name="visible">True</property>
                        <property name="label">Number of Restrictions (2–15):</property>
                        <property name="xalign">1</property>
                      </object>
                      <packing>
                        <property name="left_attach">0</property>
                        <property name="top_attach">2</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkSpinButton" id="spin_restr">
                        <property name="visible">True</property>
                        <property name="width_chars">7</property>
